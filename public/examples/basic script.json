      "note": "",
      "order": 0,
      "other": {},
      "xIds": "",
      "description": "Increments by 1 every tick.",
      "scriptEnabled": true,
      "script": "let count = ctx.state.count || 0;\n\nif (ctx.tick === 0) {\n  count = 0;\n  ctx.log('starting counter at 0');\n} else {\n  count += 1;\n  ctx.log(`incremented to ${count}`);\n}\n\nreturn {\n  value: count,\n  state: { count },\n};"
    },
    {
      "id": "part-summer",
      "type": "Unknown",
      "label": "Summer",
      "rawLabel": "Summer",
      "model": "Reference",
      "streams": [],
      "note": "",
      "order": 0,
      "other": {},
      "xIds": "",
      "description": "Sums whatever's coming in from upstream.",
      "scriptEnabled": true,
      "script": "let sum = 0;\nfor (const inp of ctx.inputs) {\n  const v = Number(inp.value) || 0;\n  sum += v;\n  ctx.log(`received ${v} from ${inp.fromLabel || 'unknown'}`);\n}\n\nctx.log(`sum = ${sum}`);\n\nreturn {\n  value: sum,\n  state: {},\n};"
    }
  ],
