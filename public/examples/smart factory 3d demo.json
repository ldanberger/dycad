    {
      "id": "edge-south",
      "type": "Node",
      "label": "Edge Compute Node (South)",
      "rawLabel": "Edge Compute Node (South)",
      "model": "Reference",
      "streams": [],
      "note": "",
      "order": 0,
      "other": {},
      "xIds": "",
