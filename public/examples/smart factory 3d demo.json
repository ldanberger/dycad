      "section": "Plant South"
    },
    {
      "id": "analytics",
      "type": "ApplicationComponent",
      "label": "Analytics Engine",
      "rawLabel": "Analytics Engine",
      "model": "Reference",
      "streams": [
        "Temperature",
        "Vibration"
      ],
      "note": "",
      "order": 0,
      "other": {},
      "xIds": "",
      "description": "",
      "scriptEnabled": true,
      "script": "// State: { lastValue, baseline } -- baseline is a slow-moving average of the risk\n// score; the badge fires on real ANOMALIES (score jumping away from its own recent\n// trend -- e.g. once Vibration Sensor S1 recovers from a fault and its reading\n// jumps back) rather than a hand-picked absolute threshold, so it stays meaningful\n// regardless of exactly how the upstream sensors are tuned.\nconst nums = ctx.inputs.map((i) => Number(i.value)).filter((v) => !Number.isNaN(v));\nconst avg = nums.length ? nums.reduce((a, b) => a + b, 0) / nums.length : (ctx.state.lastValue ?? 0);\nconst score = Math.round(avg * 10) / 10;\nconst baseline = ctx.state.baseline !== undefined ? ctx.state.baseline * 0.9 + score * 0.1 : score;\nconst result = { value: score, state: { lastValue: score, baseline } };\nif (Math.abs(score - baseline) > 6) result.rightBadge = { text: 'ANOMALY', color: '#c0392b' };\nreturn result;",
      "section": ""
    },
    {
      "id": "alerting",
      "type": "ApplicationComponent",
      "label": "Alerting Service",
      "rawLabel": "Alerting Service",
      "model": "Reference",
      "streams": [],
      "note": "",
      "order": 0,
      "other": {},
      "xIds": "",
      "description": "",
      "scriptEnabled": true,
      "script": "// State: { baseline, wasDeviated } -- own copy of the same \"deviation from a\n// slow-moving baseline\" anomaly check the Analytics Engine uses. Logs only on the\n// RISING edge (the tick it first crosses the threshold), not on every tick it stays\n// deviated -- otherwise a single sustained swing floods the Message Log with one\n// line per tick instead of one meaningful \"alert raised\" moment.\nconst incoming = Number(ctx.inputs[0]?.value);\nif (Number.isNaN(incoming)) return { value: ctx.state.lastValue ?? 0, state: ctx.state };\nconst baseline = ctx.state.baseline !== undefined ? ctx.state.baseline * 0.9 + incoming * 0.1 : incoming;\nconst deviated = Math.abs(incoming - baseline) > 6;\nconst wasDeviated = !!ctx.state.wasDeviated;\nif (deviated && !wasDeviated) {\n  ctx.log(`Risk score ${incoming} deviated from its baseline (${Math.round(baseline * 10) / 10}) at tick ${ctx.tick} -- alert raised.`);\n}\nreturn { value: incoming, state: { baseline, wasDeviated: deviated, lastValue: incoming } };",
      "section": ""
    },
