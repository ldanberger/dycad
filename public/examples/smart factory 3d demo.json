  "parts": [
    {
      "id": "temp-n1",
      "type": "Device",
      "label": "Temperature Sensor N1",
      "rawLabel": "Temperature Sensor N1",
      "model": "Reference",
      "streams": [
        "Temperature"
      ],
      "note": "",
      "order": 0,
      "other": {},
      "xIds": "",
      "description": "",
      "scriptEnabled": true,
      "script": "// State: none -- this sensor reads no inputs, just emits a synthetic\n// waveform each tick (a real sensor's noisy periodic reading).\nconst base = 50, amp = 8, phase = 0;\nconst noise = (Math.random() * 4) - 2;\nconst value = Math.round((base + amp * Math.sin((ctx.tick + phase) / 3) + noise) * 10) / 10;\nreturn { value };",
      "section": "Plant North"
    },
    {
      "id": "temp-n2",
      "type": "Device",
      "label": "Temperature Sensor N2",
      "rawLabel": "Temperature Sensor N2",
      "model": "Reference",
      "streams": [
        "Temperature"
      ],
      "note": "",
      "order": 0,
      "other": {},
      "xIds": "",
      "description": "",
      "scriptEnabled": true,
      "script": "// State: none -- this sensor reads no inputs, just emits a synthetic\n// waveform each tick (a real sensor's noisy periodic reading).\nconst base = 52, amp = 9, phase = 5;\nconst noise = (Math.random() * 4) - 2;\nconst value = Math.round((base + amp * Math.sin((ctx.tick + phase) / 3) + noise) * 10) / 10;\nreturn { value };",
      "section": "Plant North"
    },
    {
      "id": "vib-n1",
      "type": "Device",
      "label": "Vibration Sensor N1",
      "rawLabel": "Vibration Sensor N1",
      "model": "Reference",
      "streams": [
        "Vibration"
      ],
      "note": "",
      "order": 0,
      "other": {},
      "xIds": "",
      "description": "",
      "scriptEnabled": true,
      "script": "// State: none -- this sensor reads no inputs, just emits a synthetic\n// waveform each tick (a real sensor's noisy periodic reading).\nconst base = 25, amp = 12, phase = 2;\nconst noise = (Math.random() * 4) - 2;\nconst value = Math.round((base + amp * Math.sin((ctx.tick + phase) / 3) + noise) * 10) / 10;\nreturn { value };",
      "section": "Plant North"
    },
    {
      "id": "temp-s1",
      "type": "Device",
      "label": "Temperature Sensor S1",
      "rawLabel": "Temperature Sensor S1",
      "model": "Reference",
      "streams": [
        "Temperature"
      ],
      "note": "",
      "order": 0,
      "other": {},
      "xIds": "",
      "description": "",
      "scriptEnabled": true,
      "script": "// State: none -- this sensor reads no inputs, just emits a synthetic\n// waveform each tick (a real sensor's noisy periodic reading).\nconst base = 49, amp = 7, phase = 7;\nconst noise = (Math.random() * 4) - 2;\nconst value = Math.round((base + amp * Math.sin((ctx.tick + phase) / 3) + noise) * 10) / 10;\nreturn { value };",
      "section": "Plant South"
    },
    {
      "id": "vib-s1",
      "type": "Device",
      "label": "Vibration Sensor S1",
      "rawLabel": "Vibration Sensor S1",
      "model": "Reference",
      "streams": [
        "Vibration"
      ],
      "note": "",
      "order": 0,
      "other": {},
      "xIds": "",
      "description": "",
      "scriptEnabled": true,
      "script": "// State: none. Every 5 ticks this sensor drops offline for one tick (a real\n// intermittent fault) -- watch its 3D marker flash red, then resume.\nif (ctx.tick > 0 && ctx.tick % 5 === 3) {\n  throw new Error('Sensor communication timeout');\n}\nconst base = 27, amp = 14, phase = 3;\nconst noise = (Math.random() * 4) - 2;\nconst value = Math.round((base + amp * Math.sin((ctx.tick + phase) / 3) + noise) * 10) / 10;\nreturn { value };",
      "section": "Plant South"
    },
    {
      "id": "gw-north",
      "type": "ApplicationComponent",
      "label": "Sensor Gateway (North)",
      "rawLabel": "Sensor Gateway (North)",
      "model": "Reference",
      "streams": [
        "Temperature",
        "Vibration"
      ],
      "note": "",
      "order": 0,
      "other": {},
      "xIds": "",
      "description": "",
      "scriptEnabled": true,
      "script": "// State: { lastValue } -- held so a tick with no fresh inputs (tick 0, or\n// every upstream sensor mid-fault at once) still outputs something sensible\n// instead of dropping to 0.\nconst nums = ctx.inputs.map((i) => Number(i.value)).filter((v) => !Number.isNaN(v));\nconst avg = nums.length ? nums.reduce((a, b) => a + b, 0) / nums.length : (ctx.state.lastValue ?? 0);\nconst rounded = Math.round(avg * 10) / 10;\nreturn { value: rounded, state: { lastValue: rounded } };",
      "section": "Plant North"
    },
    {
      "id": "gw-south",
      "type": "ApplicationComponent",
      "label": "Sensor Gateway (South)",
      "rawLabel": "Sensor Gateway (South)",
      "model": "Reference",
      "streams": [
        "Temperature",
        "Vibration"
      ],
      "note": "",
      "order": 0,
      "other": {},
      "xIds": "",
      "description": "",
      "scriptEnabled": true,
      "script": "// State: { lastValue } -- held so a tick with no fresh inputs (tick 0, or\n// every upstream sensor mid-fault at once) still outputs something sensible\n// instead of dropping to 0.\nconst nums = ctx.inputs.map((i) => Number(i.value)).filter((v) => !Number.isNaN(v));\nconst avg = nums.length ? nums.reduce((a, b) => a + b, 0) / nums.length : (ctx.state.lastValue ?? 0);\nconst rounded = Math.round(avg * 10) / 10;\nreturn { value: rounded, state: { lastValue: rounded } };",
      "section": "Plant South"
    },
    {
